import SwiftUI
import Charts

struct SleepQualityView: View {
    @EnvironmentObject var healthService: HealthMonitoringService
    @State private var todaySleep: SleepQualityData?
    @State private var sleepHistory: [SleepQualityData] = []
    @State private var isLoading = false
    @State private var showAlert = false
    @State private var alertMessage = ""

    var body: some View {
        ScrollView {
            VStack(spacing: 20) {
                // Today's Sleep Quality Card
                VStack(spacing: 15) {
                    HStack {
                        Image(systemName: "moon.stars.fill")
                            .font(.title2)
                            .foregroundColor(.purple)
                        Text("Last Night's Sleep")
                            .font(.headline)
                        Spacer()
                    }

                    if let sleep = todaySleep {
                        // Quality Score Circle
                        ZStack {
                            Circle()
                                .stroke(Color.gray.opacity(0.2), lineWidth: 20)
                                .frame(width: 150, height: 150)

                            Circle()
                                .trim(from: 0, to: sleep.qualityScore / 100)
                                .stroke(
                                    qualityColor(for: sleep.qualityScore),
                                    style: StrokeStyle(lineWidth: 20, lineCap: .round)
                                )
                                .frame(width: 150, height: 150)
                                .rotationEffect(.degrees(-90))
                                .animation(.easeInOut, value: sleep.qualityScore)

                            VStack {
                                Text("\(Int(sleep.qualityScore))")
                                    .font(.system(size: 42, weight: .bold))
                                Text(sleep.qualityRating)
                                    .font(.subheadline)
                                    .foregroundColor(.secondary)
                            }
                        }
                        .padding()

                        // Sleep Details
                        VStack(spacing: 12) {
                            DetailRow(
                                icon: "clock.fill",
                                title: "Duration",
                                value: String(format: "%.1f hours", sleep.duration),
                                color: .blue
                            )

                            DetailRow(
                                icon: "heart.fill",
                                title: "Avg Heart Rate",
                                value: "\(Int(sleep.averageHeartRate)) BPM",
                                color: .red
                            )

                            DetailRow(
                                icon: "figure.walk",
                                title: "Movement Score",
                                value: "\(Int(sleep.movementScore))/100",
                                color: .orange
                            )
                        }
                        .padding()
                        .background(Color(white: 0.9))
                        .cornerRadius(10)

                        // Feedback
                        HStack(alignment: .top) {
                            Image(systemName: "info.circle.fill")
                                .foregroundColor(.blue)
                            Text(sleep.feedback)
                                .font(.subheadline)
                                .foregroundColor(.secondary)
                                .fixedSize(horizontal: false, vertical: true)
                        }
                        .padding()
                        .background(Color.blue.opacity(0.1))
                        .cornerRadius(10)

                    } else {
                        ProgressView()
                            .padding()
                    }
                }
                .padding()
                .background(Color(white: 0.95))
                .cornerRadius(12)
                .shadow(radius: 2)

                // Sleep History Chart
                VStack(alignment: .leading, spacing: 10) {
                    HStack {
                        Image(systemName: "chart.bar.fill")
                            .foregroundColor(.purple)
                        Text("Sleep Quality Trend")
                            .font(.headline)
                        Spacer()
                    }

                    if #available(iOS 16.0, *) {
                        Chart(sleepHistory) { data in
                            BarMark(
                                x: .value("Date", data.date, unit: .day),
                                y: .value("Quality", data.qualityScore)
                            )
                            .foregroundStyle(qualityColor(for: data.qualityScore))
                            .cornerRadius(4)
                        }
                        .frame(height: 200)
                        .chartYScale(domain: 0...100)
                        .chartYAxis {
                            AxisMarks(position: .leading)
                        }
                    } else {
                        Text("Chart available on iOS 16+")
                            .frame(height: 200)
                            .frame(maxWidth: .infinity)
                            .background(Color(white: 0.9))
                            .cornerRadius(8)
                    }
                }
                .padding()
                .background(Color(white: 0.95))
                .cornerRadius(12)
                .shadow(radius: 2)

                // Sleep Duration Chart
                VStack(alignment: .leading, spacing: 10) {
                    HStack {
                        Image(systemName: "moon.zzz.fill")
                            .foregroundColor(.indigo)
                        Text("Sleep Duration")
                            .font(.headline)
                        Spacer()
                    }

                    if #available(iOS 16.0, *) {
                        Chart(sleepHistory) { data in
                            LineMark(
                                x: .value("Date", data.date, unit: .day),
                                y: .value("Hours", data.duration)
                            )
                            .foregroundStyle(.indigo)
                            .interpolationMethod(.catmullRom)

                            AreaMark(
                                x: .value("Date", data.date, unit: .day),
                                y: .value("Hours", data.duration)
                            )
                            .foregroundStyle(.indigo.opacity(0.2))
                            .interpolationMethod(.catmullRom)

                            // Reference line for recommended sleep (7-9 hours)
                            RuleMark(y: .value("Recommended Min", 7))
                                .foregroundStyle(.green.opacity(0.5))
                                .lineStyle(StrokeStyle(dash: [5]))

                            RuleMark(y: .value("Recommended Max", 9))
                                .foregroundStyle(.green.opacity(0.5))
                                .lineStyle(StrokeStyle(dash: [5]))
                        }
                        .frame(height: 180)
                        .chartYScale(domain: 0...12)
                    } else {
                        Text("Chart available on iOS 16+")
                            .frame(height: 180)
                            .frame(maxWidth: .infinity)
                            .background(Color(white: 0.9))
                            .cornerRadius(8)
                    }
                }
                .padding()
                .background(Color(white: 0.95))
                .cornerRadius(12)
                .shadow(radius: 2)

                // Refresh Button
                Button(action: refreshData) {
                    HStack {
                        Image(systemName: "arrow.clockwise")
                        Text("Refresh")
                    }
                    .frame(maxWidth: .infinity)
                    .padding()
                    .background(Color.purple)
                    .foregroundColor(.white)
                    .cornerRadius(10)
                }
                .disabled(isLoading)
            }
            .padding()
        }
        .navigationTitle("Sleep Quality")
        .onAppear {
            refreshData()
        }
        .alert("Sleep Data Alert", isPresented: $showAlert) {
            Button("OK", role: .cancel) { }
        } message: {
            Text(alertMessage)
        }
    }

    private func refreshData() {
        isLoading = true
        todaySleep = healthService.getLatestSleepData()
        sleepHistory = []  // Sleep history not yet implemented
        isLoading = false
    }

    private func qualityColor(for score: Double) -> Color {
        switch score {
        case 85...100: return .green
        case 70..<85: return .blue
        case 55..<70: return .orange
        default: return .red
        }
    }
}

struct DetailRow: View {
    let icon: String
    let title: String
    let value: String
    let color: Color

    var body: some View {
        HStack {
            Image(systemName: icon)
                .foregroundColor(color)
                .frame(width: 30)
            Text(title)
                .foregroundColor(.secondary)
            Spacer()
            Text(value)
                .fontWeight(.semibold)
        }
    }
}

#Preview {
    NavigationView {
        SleepQualityView()
    }
}
